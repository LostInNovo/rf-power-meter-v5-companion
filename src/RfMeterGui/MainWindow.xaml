<Window x:Class="RfMeterGui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:RfMeterGui"
        Title="RF Power Meter V5 — Companion"
        Width="1180" Height="760" MinWidth="760" MinHeight="520"
        Background="{StaticResource WindowBackdropBrush}"
        FontFamily="Segoe UI" FontSize="13"
        WindowStyle="None" ResizeMode="CanResize"
        Icon="app.ico"
        Closing="Window_Closing">

    <!-- Borderless window with a custom title bar; resize + drag still work via WindowChrome -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <!-- Slow breathing glow on the main dBm readout -->
                    <DoubleAnimation Storyboard.TargetName="ReadoutGlow" Storyboard.TargetProperty="Opacity"
                                     From="0.35" To="0.8" Duration="0:0:1.6"
                                     AutoReverse="True" RepeatBehavior="Forever"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ── Custom title bar ── -->
        <Grid Grid.Row="0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                <!-- Little RF wave glyph (matches the app icon) -->
                <Path Data="M0,10 Q3,2 6,10 Q9,18 12,10 Q15,2 18,10 Q21,18 24,10" Stroke="{StaticResource AccentHotBrush}"
                      StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      VerticalAlignment="Center" Margin="0,2,10,0">
                    <Path.Effect>
                        <DropShadowEffect Color="{StaticResource AccentColor}" BlurRadius="8" ShadowDepth="0" Opacity="0.9"/>
                    </Path.Effect>
                </Path>
                <TextBlock VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold">
                    <Run Text="RF POWER METER" Foreground="{StaticResource TextBrush}"/>
                    <Run Text=" V5" Foreground="{StaticResource AccentHotBrush}"/>
                </TextBlock>
                <TextBlock Text="companion" Foreground="{StaticResource TextFaintBrush}" FontSize="11"
                           VerticalAlignment="Center" Margin="8,1,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="MinimizeButton_Click"
                        WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Minimize"/>
                <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" Content="&#xE922;" Click="MaximizeButton_Click"
                        WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Maximize"/>
                <Button Style="{StaticResource CaptionCloseButton}" Content="&#xE8BB;" Click="CloseButton_Click"
                        WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Close" Margin="0,0,6,0"/>
            </StackPanel>
        </Grid>

        <!-- ── Connection toolbar ── -->
        <Border Grid.Row="1" Margin="16,4,16,0" Padding="12,8" CornerRadius="12"
                Background="#221840" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1">
            <WrapPanel VerticalAlignment="Center">
                <TextBlock Text="PORT" Foreground="{StaticResource TextFaintBrush}" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <ComboBox x:Name="PortCombo" Width="104" Height="30" Margin="8,0,0,0" VerticalAlignment="Center"/>
                <Button x:Name="RescanPortsButton" Content="Rescan" Click="RescanPortsButton_Click" VerticalAlignment="Center"/>
                <TextBlock Text="BAUD" Foreground="{StaticResource TextFaintBrush}" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" Margin="18,0,0,0"/>
                <TextBox x:Name="BaudRateBox" Width="84" Height="30" Text="460800" Margin="8,0,0,0" VerticalAlignment="Center"/>
                <Button x:Name="ConnectButton" Style="{StaticResource AccentButton}" Content="Connect" Width="110" Height="30"
                        Click="ConnectButton_Click" VerticalAlignment="Center" Margin="14,0,0,0"/>
                <Ellipse x:Name="StatusDot" Width="9" Height="9" Fill="#5B5575" VerticalAlignment="Center" Margin="18,0,0,0"/>
                <TextBlock x:Name="ConnectionStatusText" Text="disconnected" VerticalAlignment="Center" Margin="8,0,0,0"
                           Foreground="{StaticResource TextDimBrush}" FontFamily="Consolas" FontSize="12"/>
            </WrapPanel>
        </Border>

        <Grid Grid.Row="2" Margin="16,0,16,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="348"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ── Left panel: readout, statistics, meter settings, trigger, CSV log ── -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,10,0">

                    <!-- Live readout: big neon dBm value, watts, signal bar, peak hold, floor tare -->
                    <Border Style="{StaticResource Card}" Background="#171030" BorderBrush="{StaticResource StrokeBrightBrush}">
                        <StackPanel>
                            <TextBlock x:Name="DbmReadoutText" Text="--.-" FontSize="58" FontWeight="Bold"
                                       Foreground="{StaticResource NeonBrush}" TextAlignment="Center" FontFamily="Consolas">
                                <TextBlock.Effect>
                                    <DropShadowEffect x:Name="ReadoutGlow" Color="{StaticResource AccentColor}"
                                                      BlurRadius="26" ShadowDepth="0" Opacity="0.5"/>
                                </TextBlock.Effect>
                            </TextBlock>
                            <TextBlock Text="dBm" TextAlignment="Center" Foreground="{StaticResource TextFaintBrush}"
                                       FontSize="12" Margin="0,-6,0,0" Typography.Capitals="AllSmallCaps"/>
                            <TextBlock x:Name="WattsReadoutText" Text="—" FontSize="21" TextAlignment="Center"
                                       Foreground="#A78BFA" Margin="0,6,0,0" FontFamily="Consolas"/>
                            <ProgressBar x:Name="SignalLevelBar" Height="13" Minimum="-80" Maximum="10" Value="-80"
                                         Margin="0,12,0,0"/>
                            <!-- Full-width status lines: peak hold, noise-floor reference, live delta -->
                            <TextBlock x:Name="PeakHoldText" Text="Peak hold: —" Foreground="#F0ABFC" Margin="0,10,0,0" TextWrapping="Wrap"/>
                            <TextBlock x:Name="FloorText" Text="Floor: —" Foreground="#7DD3FC" Margin="0,4,0,0" TextWrapping="Wrap"/>
                            <TextBlock x:Name="FloorDeltaText" Text="" FontSize="12" Foreground="#7DD3FC"
                                       Margin="0,4,0,0" TextWrapping="Wrap"/>
                            <!-- Buttons on their own row so the lines above never get clipped -->
                            <WrapPanel Margin="0,10,0,0">
                                <Button x:Name="PeakResetButton" Content="Reset peak" Padding="9,3" Margin="0,0,6,4" Click="PeakResetButton_Click"/>
                                <Button x:Name="FloorCaptureButton" Content="Capture floor" Padding="9,3" Margin="0,0,6,4"
                                        ToolTip="Click: 1 s average. Press and hold: averages for as long as you hold."
                                        PreviewMouseLeftButtonDown="FloorCaptureButton_MouseDown"
                                        PreviewMouseLeftButtonUp="FloorCaptureButton_MouseUp"
                                        Click="FloorCaptureButton_Click"/>
                                <Button x:Name="FloorClearButton" Content="Clear" Padding="9,3" Margin="0,0,0,4" IsEnabled="False" Click="FloorClearButton_Click"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="STATISTICS · SINCE RESET" Style="{StaticResource SectionHeaderText}"/>
                            <DockPanel>
                                <Button x:Name="StatsResetButton" DockPanel.Dock="Right" Content="Reset" VerticalAlignment="Center" Click="StatsResetButton_Click"/>
                                <StackPanel>
                                    <TextBlock x:Name="StatMinText" Text="Min:  —" FontFamily="Consolas"/>
                                    <TextBlock x:Name="StatMaxText" Text="Max:  —" FontFamily="Consolas"/>
                                    <TextBlock x:Name="StatAvgText" Text="Avg:  —" FontFamily="Consolas"/>
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <!-- Settings that live on the meter itself; see SerialWorker for the protocol -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="METER SETTINGS · ON DEVICE" Style="{StaticResource SectionHeaderText}"/>
                            <TextBlock x:Name="MeterReportsText" Text="Meter reports: not read yet" FontFamily="Consolas" TextWrapping="Wrap"/>
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="74"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="Frequency" VerticalAlignment="Center" Foreground="{StaticResource TextDimBrush}"/>
                                <TextBox x:Name="FrequencyBox" Grid.Column="1" Text="" MaxLength="4" Height="28" Margin="8,0,0,0"/>
                                <TextBlock Text="MHz" Grid.Column="2" Margin="6,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource TextFaintBrush}"/>
                                <TextBlock Text="Attenuation" Grid.Row="1" VerticalAlignment="Center" Margin="0,8,0,0" Foreground="{StaticResource TextDimBrush}"/>
                                <TextBox x:Name="AttenuationBox" Grid.Row="1" Grid.Column="1" Text="0.0" Height="28" Margin="8,8,0,0"/>
                                <TextBlock Text="dB" Grid.Row="1" Grid.Column="2" Margin="6,8,0,0" VerticalAlignment="Center" Foreground="{StaticResource TextFaintBrush}"/>
                            </Grid>
                            <WrapPanel Margin="0,12,0,0">
                                <Button x:Name="SendToMeterButton" Content="Send to meter" IsEnabled="False" Click="SendToMeterButton_Click" Margin="0,0,6,4"/>
                                <Button x:Name="ReadFromMeterButton" Content="Read from meter" IsEnabled="False" Click="ReadFromMeterButton_Click" Margin="0,0,0,4"/>
                            </WrapPanel>
                            <DockPanel Margin="0,8,0,0">
                                <TextBlock Text="Sample rate" VerticalAlignment="Center" Foreground="{StaticResource TextDimBrush}"/>
                                <ComboBox x:Name="SampleRateCombo" Height="30" Margin="8,0,0,0" IsEnabled="False"
                                          SelectionChanged="SampleRateCombo_SelectionChanged"/>
                            </DockPanel>
                            <TextBlock x:Name="MeterSettingsStatusText" Text="" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap"/>
                            <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource TextFaintBrush}" Margin="0,8,0,0"
                                       Text="Readings already include the attenuation offset and the band calibration for the set frequency — the meter applies both itself. Controls unlock after the first read. The sample rate can only be written, never read back; confirm it via the rec/s figure in the status line."/>
                        </StackPanel>
                    </Border>

                    <!-- Captures a datapoint when the level crosses the threshold and settles -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="TRIGGER CAPTURE" Style="{StaticResource SectionHeaderText}"/>
                            <WrapPanel>
                                <CheckBox x:Name="TriggerEnableCheck" Content="Enable" VerticalAlignment="Center"/>
                                <TextBlock Text="Threshold" VerticalAlignment="Center" Margin="16,0,0,0" Foreground="{StaticResource TextDimBrush}"/>
                                <TextBox x:Name="TriggerThresholdBox" Width="58" Height="28" Text="-40.0" Margin="8,0,0,0"/>
                                <TextBlock Text="dBm" VerticalAlignment="Center" Margin="6,0,0,0" Foreground="{StaticResource TextFaintBrush}"/>
                            </WrapPanel>
                            <ListBox x:Name="TriggerCapturesList" Height="92" Margin="0,10,0,0" FontFamily="Consolas" FontSize="12"/>
                            <DockPanel Margin="0,8,0,0">
                                <Button x:Name="TriggerClearButton" DockPanel.Dock="Right" Content="Clear" Click="TriggerClearButton_Click"/>
                                <TextBlock x:Name="TriggerStatusText" Text="armed when enabled" FontSize="11" Foreground="{StaticResource TextFaintBrush}" VerticalAlignment="Center"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="CSV LOG" Style="{StaticResource SectionHeaderText}"/>
                            <DockPanel>
                                <Button x:Name="CsvLogButton" DockPanel.Dock="Right" Content="Start" Width="72" Click="CsvLogButton_Click"/>
                                <TextBlock x:Name="CsvLogStatusText" Text="not logging" FontSize="11" Foreground="{StaticResource TextFaintBrush}"
                                           VerticalAlignment="Center" TextWrapping="Wrap"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- ── Right panel: live time-series chart (signal finder) ── -->
            <Grid Grid.Column="1" Margin="10,12,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <WrapPanel Grid.Row="0" Margin="2,4,0,8">
                    <TextBlock Text="WINDOW" Foreground="{StaticResource TextFaintBrush}" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <ComboBox x:Name="ChartWindowCombo" Width="84" Height="28" Margin="8,0,0,0" SelectedIndex="2" VerticalAlignment="Center">
                        <ComboBoxItem Content="10 s"/>
                        <ComboBoxItem Content="30 s"/>
                        <ComboBoxItem Content="60 s"/>
                        <ComboBoxItem Content="5 min"/>
                    </ComboBox>
                    <CheckBox x:Name="MaxTraceCheck" Content="Max trace" IsChecked="True" VerticalAlignment="Center" Margin="16,0,0,0"/>
                    <TextBlock Text="trace color = strength:" Foreground="{StaticResource TextFaintBrush}" FontSize="11" VerticalAlignment="Center" Margin="18,0,0,0"/>
                    <TextBlock Text=" ● low" Foreground="#3B82F6" FontSize="11" VerticalAlignment="Center"/>
                    <TextBlock Text=" ● mid" Foreground="#F59E0B" FontSize="11" VerticalAlignment="Center"/>
                    <TextBlock Text=" ● hot" Foreground="#EF4444" FontSize="11" VerticalAlignment="Center"/>
                    <TextBlock Text="  ┄ peak hold" Foreground="{StaticResource TextDimBrush}" FontSize="11" VerticalAlignment="Center"/>
                </WrapPanel>
                <Grid Grid.Row="1">
                    <!-- Static shadow card behind the chart, so the live chart isn't inside an Effect subtree -->
                    <Border Background="#130C22" CornerRadius="14">
                        <Border.Effect>
                            <DropShadowEffect Color="#000000" BlurRadius="22" ShadowDepth="4" Opacity="0.45"/>
                        </Border.Effect>
                    </Border>
                    <Border BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" CornerRadius="14" ClipToBounds="True" Padding="6">
                        <local:SignalChart x:Name="TimeSeriesChart" ClipToBounds="True"/>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>

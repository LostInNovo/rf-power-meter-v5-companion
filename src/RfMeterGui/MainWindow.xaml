<Window x:Class="RfMeterGui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RF Power Meter V5 — Companion"
        Width="1120" Height="720" MinWidth="720" MinHeight="480"
        Background="#FF14171C" FontFamily="Segoe UI" FontSize="13"
        Closing="Window_Closing">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFD8DEE6"/>
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Foreground" Value="#FF9AA7B8"/>
            <Setter Property="BorderBrush" Value="#FF333B47"/>
            <Setter Property="Margin" Value="0,10,0,0"/>
            <Setter Property="Padding" Value="8"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#FFD8DEE6"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Connection toolbar: port selection, baud, connect/disconnect, live status -->
        <WrapPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Port" VerticalAlignment="Center"/>
            <ComboBox x:Name="PortCombo" Width="100" Margin="6,0,0,0" VerticalAlignment="Center"/>
            <Button x:Name="RescanPortsButton" Content="Rescan" Click="RescanPortsButton_Click" VerticalAlignment="Center"/>
            <TextBlock Text="Baud" VerticalAlignment="Center" Margin="14,0,0,0"/>
            <TextBox x:Name="BaudRateBox" Width="80" Text="460800" Margin="6,0,0,0" VerticalContentAlignment="Center" VerticalAlignment="Center"/>
            <Button x:Name="ConnectButton" Content="Connect" Width="100" Click="ConnectButton_Click" VerticalAlignment="Center"/>
            <TextBlock x:Name="ConnectionStatusText" Text="disconnected" VerticalAlignment="Center" Margin="16,0,0,0" Foreground="#FF8090A0"/>
        </WrapPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left panel: readout, statistics, meter settings, trigger, CSV log -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,8,0">

                    <!-- Live readout: big dBm value, watts, signal bar, peak hold -->
                    <Border Background="#FF10141A" BorderBrush="#FF333B47" BorderThickness="1" Padding="10" CornerRadius="4">
                        <StackPanel>
                            <TextBlock x:Name="DbmReadoutText" Text="--.-" FontSize="54" FontWeight="Bold"
                                       Foreground="#FF7CE38B" TextAlignment="Center" FontFamily="Consolas"/>
                            <TextBlock Text="dBm" TextAlignment="Center" Foreground="#FF8090A0" Margin="0,-6,0,0"/>
                            <TextBlock x:Name="WattsReadoutText" Text="—" FontSize="20" TextAlignment="Center"
                                       Foreground="#FF9AD0F0" Margin="0,6,0,0" FontFamily="Consolas"/>
                            <ProgressBar x:Name="SignalLevelBar" Height="12" Minimum="-80" Maximum="10" Value="-80"
                                         Margin="0,10,0,0" Foreground="#FF7CE38B" Background="#FF22272F" BorderBrush="#FF333B47"/>
                            <!-- Full-width status lines: peak hold, noise-floor reference, live delta -->
                            <TextBlock x:Name="PeakHoldText" Text="Peak hold: —" Foreground="#FFE8B45A" Margin="0,8,0,0" TextWrapping="Wrap"/>
                            <TextBlock x:Name="FloorText" Text="Floor: —" Foreground="#FF9AD0F0" Margin="0,4,0,0" TextWrapping="Wrap"/>
                            <TextBlock x:Name="FloorDeltaText" Text="" FontSize="12" Foreground="#FF9AD0F0"
                                       Margin="0,4,0,0" TextWrapping="Wrap"/>
                            <!-- Buttons on their own row so the lines above never get clipped -->
                            <WrapPanel Margin="0,8,0,0">
                                <Button x:Name="PeakResetButton" Content="Reset peak" Padding="7,2" Margin="0,0,6,4" Click="PeakResetButton_Click"/>
                                <Button x:Name="FloorCaptureButton" Content="Capture floor" Padding="7,2" Margin="0,0,6,4"
                                        ToolTip="Click: 1 s average. Press and hold: averages for as long as you hold."
                                        PreviewMouseLeftButtonDown="FloorCaptureButton_MouseDown"
                                        PreviewMouseLeftButtonUp="FloorCaptureButton_MouseUp"
                                        Click="FloorCaptureButton_Click"/>
                                <Button x:Name="FloorClearButton" Content="Clear" Padding="7,2" Margin="0,0,0,4" IsEnabled="False" Click="FloorClearButton_Click"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <GroupBox Header="Statistics (since reset)">
                        <DockPanel>
                            <Button x:Name="StatsResetButton" DockPanel.Dock="Right" Content="Reset" VerticalAlignment="Center" Click="StatsResetButton_Click"/>
                            <StackPanel>
                                <TextBlock x:Name="StatMinText" Text="Min:  —" FontFamily="Consolas"/>
                                <TextBlock x:Name="StatMaxText" Text="Max:  —" FontFamily="Consolas"/>
                                <TextBlock x:Name="StatAvgText" Text="Avg:  —" FontFamily="Consolas"/>
                            </StackPanel>
                        </DockPanel>
                    </GroupBox>

                    <!-- Settings that live on the meter itself; see SerialWorker for the protocol -->
                    <GroupBox Header="Meter settings (stored on the device)">
                        <StackPanel>
                            <TextBlock x:Name="MeterReportsText" Text="Meter reports: not read yet" FontFamily="Consolas" TextWrapping="Wrap"/>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="Frequency" VerticalAlignment="Center"/>
                                <TextBox x:Name="FrequencyBox" Grid.Column="1" Text="" MaxLength="4" Margin="8,0,0,0" VerticalContentAlignment="Center"/>
                                <TextBlock Text="MHz" Grid.Column="2" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Attenuation" Grid.Row="1" VerticalAlignment="Center" Margin="0,6,0,0"/>
                                <TextBox x:Name="AttenuationBox" Grid.Row="1" Grid.Column="1" Text="0.0" Margin="8,6,0,0" VerticalContentAlignment="Center"/>
                                <TextBlock Text="dB" Grid.Row="1" Grid.Column="2" Margin="6,6,0,0" VerticalAlignment="Center"/>
                            </Grid>
                            <WrapPanel Margin="0,10,0,0">
                                <Button x:Name="SendToMeterButton" Content="Send to meter" IsEnabled="False" Click="SendToMeterButton_Click" Margin="0,0,6,4"/>
                                <Button x:Name="ReadFromMeterButton" Content="Read from meter" IsEnabled="False" Click="ReadFromMeterButton_Click" Margin="0,0,0,4"/>
                            </WrapPanel>
                            <DockPanel Margin="0,6,0,0">
                                <TextBlock Text="Sample rate" VerticalAlignment="Center"/>
                                <ComboBox x:Name="SampleRateCombo" Margin="8,0,0,0" IsEnabled="False"
                                          SelectionChanged="SampleRateCombo_SelectionChanged"/>
                            </DockPanel>
                            <TextBlock x:Name="MeterSettingsStatusText" Text="" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"/>
                            <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#FF8090A0" Margin="0,6,0,0"
                                       Text="Readings already include the attenuation offset and the band calibration for the set frequency — the meter applies both itself. Controls unlock after the first read. The sample rate can only be written, never read back; confirm it via the rec/s figure in the status line."/>
                        </StackPanel>
                    </GroupBox>

                    <!-- Captures a datapoint when the level crosses the threshold and settles -->
                    <GroupBox Header="Trigger capture">
                        <StackPanel>
                            <WrapPanel>
                                <CheckBox x:Name="TriggerEnableCheck" Content="Enable" VerticalAlignment="Center"/>
                                <TextBlock Text="Threshold" VerticalAlignment="Center" Margin="14,0,0,0"/>
                                <TextBox x:Name="TriggerThresholdBox" Width="56" Text="-40.0" Margin="6,0,0,0" VerticalContentAlignment="Center"/>
                                <TextBlock Text="dBm" VerticalAlignment="Center" Margin="4,0,0,0"/>
                            </WrapPanel>
                            <ListBox x:Name="TriggerCapturesList" Height="92" Margin="0,8,0,0" FontFamily="Consolas" FontSize="12"
                                     Background="#FF1B2027" Foreground="#FFD8DEE6" BorderBrush="#FF333B47"/>
                            <DockPanel Margin="0,6,0,0">
                                <Button x:Name="TriggerClearButton" DockPanel.Dock="Right" Content="Clear" Click="TriggerClearButton_Click"/>
                                <TextBlock x:Name="TriggerStatusText" Text="armed when enabled" FontSize="11" Foreground="#FF8090A0" VerticalAlignment="Center"/>
                            </DockPanel>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="CSV log">
                        <StackPanel>
                            <DockPanel>
                                <Button x:Name="CsvLogButton" DockPanel.Dock="Right" Content="Start" Width="70" Click="CsvLogButton_Click"/>
                                <TextBlock x:Name="CsvLogStatusText" Text="not logging" FontSize="11" Foreground="#FF8090A0"
                                           VerticalAlignment="Center" TextWrapping="Wrap"/>
                            </DockPanel>
                        </StackPanel>
                    </GroupBox>

                </StackPanel>
            </ScrollViewer>

            <!-- Right panel: scrolling power-vs-time chart with window selector and legend -->
            <Grid Grid.Column="1" Margin="8,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <WrapPanel Grid.Row="0" Margin="0,0,0,6">
                    <TextBlock Text="Window" VerticalAlignment="Center"/>
                    <ComboBox x:Name="ChartWindowCombo" Width="80" Margin="6,0,0,0" SelectedIndex="2" VerticalAlignment="Center">
                        <ComboBoxItem Content="10 s"/>
                        <ComboBoxItem Content="30 s"/>
                        <ComboBoxItem Content="60 s"/>
                        <ComboBoxItem Content="5 min"/>
                    </ComboBox>
                    <CheckBox x:Name="MaxTraceCheck" Content="Max trace" IsChecked="True" VerticalAlignment="Center" Margin="14,0,0,0"/>
                    <TextBlock Text="  avg" Foreground="#FF7CE38B" VerticalAlignment="Center" Margin="14,0,0,0"/>
                    <TextBlock Text="  max" Foreground="#FFE8B45A" VerticalAlignment="Center"/>
                    <TextBlock Text="  peak hold" Foreground="#FFE85A5A" VerticalAlignment="Center"/>
                </WrapPanel>
                <Border Grid.Row="1" Background="#FF10141A" BorderBrush="#FF333B47" BorderThickness="1">
                    <Canvas x:Name="ChartCanvas" ClipToBounds="True"/>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
